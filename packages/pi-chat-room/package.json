{
  "name": "@d3ara1n/pi-chat-room",
  "version": "0.2.3",
  "type": "module",
  "description": "Agent-to-agent messaging for pi — built on @d3ara1n/pi-mesh. Exposes the send_to tool so agents can message each other; incoming messages arrive as user messages prefixed [From: NAME], queued until idle. Role-agnostic and order-agnostic: just the messaging layer.",
  "homepage": "https://github.com/d3ara1n/pi-extensions/tree/main/packages/pi-chat-room#readme",
  "bugs": {
    "url": "https://github.com/d3ara1n/pi-extensions/issues"
  },
  "main": "src/index.ts",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@d3ara1n/pi-mesh": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@d3ara1n/pi-mesh": {
      "optional": true
    }
  },
  "dependencies": {
    "@d3ara1n/pi-mesh": "*"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/d3ara1n/pi-extensions",
    "directory": "packages/pi-chat-room"
  },
  "license": "MIT"
}
